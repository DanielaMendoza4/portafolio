# Credenciales de EmailJS (https://www.emailjs.com/).
# Copia este archivo como ".env" en la raíz del proyecto y completa los valores.
#
# Ojo: toda variable que empieza con VITE_ se compila dentro del bundle y
# es 100% visible en el navegador (View Source / DevTools). Eso es normal y
# está permitido para EmailJS, pero no pongas aquí claves privadas.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
